    {"name":"scale","lsb":32,"width":4},
    {"name":"stream_slot","lsb":36,"width":4},
    {"name":"form_id","lsb":40,"width":4},
    {"name":"step_index","lsb":44,"width":4},
    {"name":"gate","lsb":48,"width":8,"form_dependent":true},
    {"name":"structure","lsb":56,"width":2},
    {"name":"wheel_unit","lsb":58,"width":3},
    {"name":"cycle_step","lsb":61,"width":3}
  ],
  "top_byte_semantics": "South Halo = cycle_step:3, wheel_unit:3, structure:2. Prefilter only, not authentication.",

    "3":"ieee754_binary32_raw",
    "4":"voxel_cube",
    "5":"central_core_8",
    "6":"stella_octangula",
    "7":"cuboctahedron",
    "8":"geodesic_icosahedron",
    "9":"hurwitz_units",
    "10":"binary_dihedral_group",
    "11":"nine_ray_cyclic",
    "12":"central_cell_8_ghost",
    "13":"golden_circle",
    "14":"mod30_wheel",
    "15":"external_codex_escape"
  },
  "explicitly_not_in_this_spec": [
    "Transport envelope byte layout",
    "Authenticated session cryptography and nonce scheme",
    "Complete form-specific encoder and canonical validation for forms 0-15",
    "Legacy ZONE/TYPE/SEQ/PAYLOAD encoding",
    "CPU native struct field packing"
  ]
